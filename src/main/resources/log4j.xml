<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<!-- mule-jobs-api | master | MIXED (1 old + 1 new) | Expected: SUCCESS -->
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">
    <appender name="CONSOLE" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <PatternLayout pattern="%d{ISO8601} %-5level [%thread] %logger{36} - %msg%n"/>
        </layout>
    </appender>
    <appender name="JOBS_FILE" class="org.apache.log4j.RollingFileAppender">
        <param name="File" value="${app.home}/logs/mule-jobs-api.log"/>
        <layout class="org.apache.log4j.PatternLayout">
            <PatternLayout pattern="%d{ISO8601} %-5level [%thread] %logger{36} - %msg%n"/>
        </layout>
    </appender>
    <root><priority value="INFO"/><appender-ref ref="CONSOLE"/><appender-ref ref="JOBS_FILE"/></root>
</log4j:configuration>